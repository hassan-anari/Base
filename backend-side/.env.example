# Local demo only. Never reuse these placeholder values in a deployment.
DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-local-development-value
JWT_SECRET=replace-with-a-different-random-local-development-value
ALLOWED_HOSTS=127.0.0.1,localhost

# This signer derives complete private keys and emits synthetic broadcasts.
MPC_SIGNER_BACKEND=local_key
CUSTODY_DEMO_MODE=true
LOCAL_KEY_ENCRYPTION_PASSPHRASE=replace-with-a-strong-local-demo-passphrase
CUSTODY_INDEXER_MODE=stub

# Money-moving demo flows require explicit, non-placeholder addresses.
HOT_WALLET_ETH=0x0000000000000000000000000000000000000001
HOT_WALLET_BSC=0x0000000000000000000000000000000000000001
HOT_WALLET_TRX=TReplaceWithLocalDemoAddress
HOT_WALLET_SOL=ReplaceWithLocalDemoAddress111111111111111111
HOT_WALLET_TON=0:replace_with_64_hex_characters
